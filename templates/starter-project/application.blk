  maxCamera{
    move_step:r=80
    strife_step:r=80
    control_multiplier:r=12
  }
}

csgEntityView{
  small-tower {
    p:p2= -5,  -5
    p:p2= -5,   5
    p:p2=  5,   5
    p:p2=  5,  -5
  }
  rectangle {
    p:p2=-20, -12
    p:p2=-20,  12
    p:p2= 20,  12
    p:p2= 20, -12
  }
  circle-oct-tower {
    p:p2= -5,  -5
    p:p2=-7.07, 0
    p:p2= -5,   5
