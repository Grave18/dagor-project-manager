    p:p2=  9, -29
    p:p2=  7, -30
    p:p2=-37, -30
    p:p2=-39, -29
    p:p2=-40, -27
    p:p2=-40,   0
    p:p2=-42,   5
    p:p2=-42,  15
    p:p2=-40,  20
    p:p2=-40,  27
    p:p2=-37,  30
    p:p2= 57,  30
    p:p2= 60,  27
    p:p2= 60, -30
    p:p2= 18, -30
    p:p2= 16, -29
    p:p2= 15, -27
    p:p2= 15, -20
    p:p2= 50, -20
    p:p2= 50,  20
    p:p2=-30,  20
    p:p2=-30, -20
  }
  double-T {
    p:p2= -5,  -5
    p:p2= -5, -15
    p:p2=-15, -15
    p:p2=-15,  15
    p:p2= -5,  15
    p:p2= -5,   5
    p:p2=  5,   5
    p:p2=  5,  15
    p:p2= 15,  15
    p:p2= 15, -15
    p:p2=  5, -15
    p:p2=  5,  -5
  }
}
