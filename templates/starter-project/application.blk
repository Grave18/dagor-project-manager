lightmap{
  High{
    passes:i=4;cub5:b=no;perLight:b=yes
    map{size:i=64;size:i=128;size:i=64;size:i=64;size:i=64;}
  }
}


//plugin-specific data
projectDefaults{
  disableWater:b=yes

  riMgr {
    type:t="collision"
    gridCellSize:r=2048
    subGridSize:i=8
    minGridCellSize:r=512
    minGridCellCount:i=16
    writeOptTree:b=yes
    packedRIBB:b=yes
    gen {
      PC:b=yes
      and:b=yes
      iOS:b=yes
    }
  }
  prefabMgr {
    clipmapShaderRE:t="mesh_combined|land_mesh_height_decal"
  }
  envi{
    //type:t="collision"
    type:t="skies"
    znear:r=0.1
    zfar:r=20000

    skiesFilePathPrefix:t="develop/"
    skiesWeatherTypes:t="environments/weather_types.blk"
    skiesPresets:t="environments/weather_preset_*.blk"
    skiesGlobal:t="environments/global.blk"

    daSkiesDepthTex:t="main_intzDepthTex"

    enviNames {
      morning:b=yes
      day:b=yes
      evening:b=yes
      night:b=yes
    }

    skies{
    }
  }
  hmap{
    type:t="aces"
  }
  scnExport{
    removeInsideFaces:b=false
  }

  preferZLIB:b=yes
}

shader_glob_vars_scheme
{
  common
  {
    assetViewer
    {
      caption:t="show_no_aa"
      show_no_aa:i = 0
    }
  }
}

heightMap {
  useMeshSurface:b=true
  requireTileTex:b=true
  hasColorTex:b=false
  hasLightmapTex:b=true
  storeNxzInLtmapTex:b=true

  genFwdRadius:r=10000
  genBackRadius:r=5000
  genDiscardRadius:r=12500

  landClassLayers {
    layer {
      name:t="detailTex"  // layer name
      bits:i=4            // layer bit width

      attr:t="detTexSlot" // optional list of named attributes
      //attr:t="landClassSlot"
    }
    layer {
      name:t="land"
      bits:i=4

      attr:t="landClassSlot"
    }
    layer {
      name:t="adds"
      bits:i=4

      attr:t="landClassSlot"
    }
    layer {
      name:t="importanceMask"
      bits:i=8
      attr:t="importanceMaskSlot"
    }
  }

  lightmapCvtProps {
    fmt:t="DXT5"
    swizzleARGB:t="G0RB"
    addr:t="mirror"
    hqMip:i=0;mqMip:i=0;lqMip:i=0
    gamma:r=1
  }
}




additional_platforms
{
//  platform:t="iOS"
//  platform:t="and"
}

parameters {
  maxTraceDistance:r=15000
}

AssetLight
{
  //texture_name:t="develop/assets/gameRes/cube/stalingrad_noon_cubemap.dds"
  //shader_var:t="dynamic_cube_tex"
