scatteringEffect:p2 = 0.3,1.2

sky{
  mie_height:p2=3.0, 5.0
  mieG:p2=0.35, 0.4
  betaMScale:p2=6.5, 9.5
  clouds_overcast:p2=0.9, 0.99
}

clouds_gen{
  humidity:p2=0.65, 0.85
  persistence:p2=0.6, 0.8
  asymmetry:p2=0.11, 0.2
}

clouds_position{
  sizeX:p2=111, 111
  sizeZ:p2=99, 99
  start_altitude:p2=1.3, 2.5
  thickness:p2=3.0, 6.0
  light_extinction:p2=0.8, 1.4
  amb_extinction_mul:p2=0.5, 1.0
}
clouds_render{
  silver_lining:p2=0.5, 0.8
  sun_light:p2=0.2, 0.5
  ambient:p2=0.3, 0.8
  silver_lining_eccentricity:p2=0.5, 0.8
}

strata_clouds{
  amount:p2=0.3, 0.95
  altitude:p2=10, 11.9
}

weatherScaleSearchLight:r=0.2
cloud_shadow_intensity:r=1.0
cloudDropletsScale:r = 0.5

rainSplashEnabled:b = no

include "_rain_shower.blk"

windParams{
  defaultWindSpeed:r = 0.1
  height0:r = 1200
  turbulence0:r = 2.0
  windMul0:r = 1
  height1:r = 2000
  turbulence1:r = 1.5
  windMul1:r = 1
  height2:r = 8000
  turbulence2:r = 0.5
  windMul2:r = 0.01
  // wind spead multiplier affect on speed from previous height
  // so windSpeed(5000) = windSpeed(2000) * windMul2 = (windSpeed(1000) * windMul1) * windMul2 = 
  // ((windSpeed(0) * windMul0) * windMul1) * windMul2
}
wind_strength:r = 4

rain{probability:r=0.98;}

dustMul:r = 0
mudMul:r = 2

include "_generic_common.blk"
