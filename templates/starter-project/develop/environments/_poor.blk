}

clouds_render{
  silver_lining:p2=0.5, 1.0
  sun_light:p2=0.25, 0.68
  ambient:p2=0.5, 1.0
  silver_lining_eccentricity:p2=0.4, 0.75
}

strata_clouds{
  amount:p2=0.8, 1.0
  altitude:p2=8, 11.9
}

weatherScaleSearchLight:r=0.2
cloud_shadow_intensity:r=0.95


cloudDropletsScale:r = 0.5

windParams{
  defaultWindSpeed:r = 0.1
  height0:r = 600
  turbulence0:r = 1.0
  windMul0:r = 1
  height1:r = 2000
  turbulence1:r = 0.7
  windMul1:r = 1
  height2:r = 3000
  turbulence2:r = 0.1
  windMul2:r = 0.01
  // wind spead multiplier affect on speed from previous height
  // so windSpeed(5000) = windSpeed(2000) * windMul2 = (windSpeed(1000) * windMul1) * windMul2 = 
  // ((windSpeed(0) * windMul0) * windMul1) * windMul2
}
wind_strength:r = 4.7

rain{probability:r=0.02;}
