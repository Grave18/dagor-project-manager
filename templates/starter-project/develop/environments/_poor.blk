scatteringEffect:p2 = 0.5,1.0

sky{
  mie_height:p2=4.0, 5.0
  mieG:p2=0.25, 0.4
  betaMScale:p2=5.0, 7.0
  clouds_overcast:p2=0.6, 0.8
}

clouds_gen{
  humidity:p2=0.65, 0.9
  persistence:p2=0.7, 0.8
  asymmetry:p2=0.3, 0.4
}

clouds_position{
  sizeX:p2=111, 111
  sizeZ:p2=99, 99
  start_altitude:p2=1.5, 2.5
  thickness:p2=3.0, 6.0
  light_extinction:p2=0.5, 0.6
