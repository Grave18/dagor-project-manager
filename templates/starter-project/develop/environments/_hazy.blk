}

clouds_gen{
  humidity:p2=0.22, 0.38
  persistence:p2=0.5, 0.8
  asymmetry:p2=0.1, 0.2
}

clouds_position{
  sizeX:p2=111, 111
  sizeZ:p2=99, 99
  start_altitude:p2=1.8, 3.0
