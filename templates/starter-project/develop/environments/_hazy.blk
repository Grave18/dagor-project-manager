}

cloud_shadow_intensity:r=0.8

windParams{
  defaultWindSpeed:r = 0.05
  height0:r = 1000
  turbulence0:r = 0.3
  windMul0:r = 1
  height1:r = 3000
  turbulence1:r = 0.3
  windMul1:r = 1
  height2:r = 8000
  turbulence2:r = 0.3
  windMul2:r = 0.01
  // wind spead multiplier affect on speed from previous height
  // so windSpeed(5000) = windSpeed(2000) * windMul2 = (windSpeed(1000) * windMul1) * windMul2 = 
  // ((windSpeed(0) * windMul0) * windMul1) * windMul2
}
wind_strength:r = 4

rain{probability:r=0.0;}
