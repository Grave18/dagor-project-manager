cloudDropletsScale:r = 0.5
scatteringEffect:p2 = 1.5,2.5

sky{
  mie_height:p2=3.0, 4.0
  mieG:p2=0.25, 0.3
  betaMScale:p2=7.5, 8.0
  clouds_overcast:p2=1.0, 1.0
}

clouds_gen{
  humidity:p2=0.75, 0.95
  persistence:p2=0.5, 0.8
  asymmetry:p2=0.1, 0.2
}

clouds_position{
  sizeX:p2=111, 111
  sizeZ:p2=99, 99
  start_altitude:p2=1.0, 2.0
  thickness:p2=3.0, 5.0
  light_extinction:p2=0.8, 2.8
  amb_extinction_mul:p2=0.9, 1.5
}

clouds_render{
  silver_lining:p2=0.5, 1.0
  sun_light:p2=0.25, 0.5
  ambient:p2=0.5, 0.6
  silver_lining_eccentricity:p2=0.4, 0.75
}

strata_clouds{
  amount:p2=0.9, 1.0
  altitude:p2=9, 11.9
}

weatherScaleSearchLight:r=0.2
cloud_shadow_intensity:r=0.9

windParams{
  defaultWindSpeed:r = 0.1
  height0:r = 600
  turbulence0:r = 0.1
  windMul0:r = 1
  height1:r = 2000
  turbulence1:r = 0.7
  windMul1:r = 1
  height2:r = 8000
  turbulence2:r = 0.1
  windMul2:r = 0.01
  // wind spead multiplier affect on speed from previous height
  // so windSpeed(5000) = windSpeed(2000) * windMul2 = (windSpeed(1000) * windMul1) * windMul2 = 
  // ((windSpeed(0) * windMul0) * windMul1) * windMul2
}
wind_strength:r = 5


rain{probability:r=0.05;}

dustMul:r = 0
mudMul:r = 2

include "_generic_common.blk"
