treeDestractible{
  heightThreshold:r = 5.0
  impulseThresholdMult:r = 1000
}

maxTankInactiveTime:r = 10


ground_decals_detail
{
  usegroundDecalsDetail:b = yes
  uvScale:r = 1.0
  sharpness:r = 1.5
  scale:r = 0.5
}

TreesTopProjection
{
  texName:t = "tree_snow_d"
  texNameCompatibility:t = "tree_snow_comp_d"
  normalY:r = 0.07;
  sharpness:r = 3.5;
}

apex
{
  gravity:r = -9.8
  randomTorque:r = 100000
  calculatePlayerViscosity:b=yes

  numActiveChunks:ip2 = 40, 80
  numLandscapeCollidableChunks:ip2 = 80, 200
  numCollisionPairs:ip2 = 300, 600

  minCaliber:r = 0.03
  caliber2SimpleRadius:r = 50.0
  simpleDamageRadius:p2 = 2.0, 6.0
  hitPower2ApexDmg:r = 5.0

  explosionHitPower2ApexDmg:r = 9.0
  apexExplosionRadiusMultiplier:r = 10.0
  explosionRadius:p2 = 2.0, 8.0
  minRadiusExplosionStrength:p2 = 400.0, 1200.0
  maxRadiusExplosionStrength:p2 = 80.0, 400.0

  //destructions view properties
  fractureTimeCurvePower:r = 0.4 //curvature of (1-x)^y, where Y = fractureTimeCurvePower. curve shows undestructed chunk number in time

  //effects properties
  fractureEffectProbability:r=1 //probability for effect on fracture moment
  groundEffectProbability:r=1 //probability for effect on ground hit moment
  groundFxScaleAccordingToSize:p3= 1, 0.1, 2.0 //multiplier, depending on chunk size
  chunkVelocityForFxScale:p2 = 2, 10 //chunk velocity that affects fx scale
  fxScaleAccordingToVelocity:p2 = 0.7, 1.5 //fx scale that is affected by velocity
  groundFxMinMaxScale:p2=0.05, 2.5

  //sound
  fractureSoundProbability:r = 1.0

  //destruction time options
  timeToSinkDelta:r = 10 //time to sink after end of destruction
  timeToFractureMin:r=3 //min destruction time
  timeToFractureMax:r = 20 //max destruction time
  maxRandomDestrTimePercent:r = 0.75

  //building size options
  destructionSpeedAssetAreaInfo:p2= 60, 100 //min-max square of building
  destructionSpeedAssetHeightInfo:p2=5, 20 //min-max building's height

  //first shoot parameters
  firstShootBuildingSize:p2=4.0, 30.0
  firstShootKineticDamageMult:p2=1.0, 3.0 //kinetic damage power
  firstShootKineticDamageRadiusMult:p2=0.2, 0.7 //kinetic damage radius
  firstShootExplDamageMult:p2=0.3, 0.1 //explosion damage ppower
  firstShootExplDamageRadiusMult:p2=2.0, 6.0 //explosion damage radius

  //event log
  eventLogEnabled:b=true
  eventLogMaxCriticalFrames:i=10
  eventLogCriticalFramerate:r=10.0
  eventLogMaxSendsPerSession:i=3
  eventLogSendInterval:i=30
  eventLogMaxmEvents:i=20
  eventLogMaxTimemarks:i=20

  //restrictions
  maxSeparateVboForRender:i = 10000000 //1000
  maxSeparateVboMemory:i = 524288000 //52428800, in bytes
  maxSeparateTexturesForRender:i = 1000000 //1000
}

airplane {
  glowMul:r = 0.0
  starGlowMul:r = 1.0
}
tank {
  glowMul:r = 1.0 //temporary hack for not working weather presets
  starGlowMul:r=1.0 //temporary hack for not working weather presets
