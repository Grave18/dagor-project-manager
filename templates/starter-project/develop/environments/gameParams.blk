tankDirt
{
  dirtMaxAmount:p2 = 1000, 1000
  
  ground
  {
    tdustColor:p4 = 0.09, 0.065, 0.05, 1.0
    dustParams:p4 = 1.0, 0.5, 1.0, 0.2
    dustParams2:p4 = 2.0, 0.75, 0.6, 1.0
    mudColor:p4 = 0.035, 0.022, 0.017, 1.0
    dirtParams:p4 = 0.28, 4.0, 0.0, 1.0
    mudParams:p4 = 0.98, 1.0, 0.0, 0.392
    tankDirtMask:t = "mud_mask_m"
    tankDirtNoise:t = "mud_noise_n"
    dirtMaskScale:r = 1.0
  }
  
  snow
  {
    tdustColor:p4 = 1.0, 1.0, 1.0, 1.0
    dustParams:p4 = 1.0, 0.5, 1.0, 0.1
    dustParams2:p4 = 1.0, 0.25, 0.5, 0.8
    mudColor:p4 = 0.0, 0.0, 0.0, 0.0
    dirtParams:p4 = 0.6, 6.0, 1.0, 0.7
    mudParams:p4 = 0.98, 1.0, 0.0, 0.392
    tankDirtMask:t = "snow_color"
    tankDirtNoise:t = "snow_noise_mask"
    dirtMaskScale:r = 6.0
  }
}

