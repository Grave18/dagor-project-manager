{
  "name": "dagor-project-manager",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "license": "MIT",
  "icon": "media/dagor.png",
  "extensionKind": [
    "workspace"
  ],
  "version": "0.1.0",
  "publisher": "project-stalker",
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "l10n": "./l10n",
  "scripts": {
    "extract-l10n": "npx @vscode/l10n-dev export --outDir ./l10n ./src",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test test/extension.test.js test/projectGenerator.test.js test/starterBuild.test.js test/starterLevel.test.js test/projectWebview.test.js test/localization.test.js test/pathUtils.test.js test/sceneDeletionController.test.js test/projectCatalog.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "dagorProjectManager.openWithBlkEditor",
        "title": "%command.openWithBlkEditor.title%"
      },
      {
        "command": "dagorProjectManager.openWithDaEditor",
        "title": "%command.openWithDaEditor.title%"
      },
      {
        "command": "dagorProjectManager.openWithDaViewer",
        "title": "%command.openWithDaViewer.title%"
      },
      {
        "command": "dagorProjectManager.openSceneWithDaEditor",
        "title": "%command.openSceneWithDaEditor.title%"
      },
      {
        "command": "dagorProjectManager.openProjectWithDaViewer",
        "title": "%command.openProjectWithDaViewer.title%"
      },
      {
        "command": "dagorProjectManager.buildProject",
        "title": "%command.buildProject.title%"
      },
      {
        "command": "dagorProjectManager.buildAllFromContext",
        "title": "%command.buildAllFromContext.title%",
        "category": "%extension.category%"
      },
      {
        "command": "dagorProjectManager.buildCodeFromContext",
        "title": "%command.buildCodeFromContext.title%",
        "category": "%extension.category%"
      },
      {
        "command": "dagorProjectManager.buildShadersFromContext",
        "title": "%command.buildShadersFromContext.title%",
        "category": "%extension.category%"
      },
      {
        "command": "dagorProjectManager.buildAssetsFromContext",
        "title": "%command.buildAssetsFromContext.title%",
        "category": "%extension.category%"
      },
      {
        "command": "dagorProjectManager.buildVromfsFromContext",
        "title": "%command.buildVromfsFromContext.title%",
        "category": "%extension.category%"
      },
      {
        "command": "dagorProjectManager.buildGuiFromContext",
        "title": "%command.buildGuiFromContext.title%",
        "category": "%extension.category%"
      },
      {
        "command": "dagorProjectManager.generateProject",
        "title": "%command.generateProject.title%"
      },
      {
        "command": "dagorProjectManager.refreshProjects",
        "title": "%command.refreshProjects.title%"
      },
      {
        "command": "dagorProjectManager.runSceneInGame",
        "title": "%command.runSceneInGame.title%",
        "category": "%extension.category%"
      },
      {
        "command": "dagorProjectManager.revealContextTarget",
        "title": "%command.revealContextTarget.title%",
        "category": "%extension.category%"
      },
      {
        "command": "dagorProjectManager.revealContextTargetInOS",
        "title": "%command.revealContextTargetInOS.title%",
        "category": "%extension.category%"
      },
      {
        "command": "dagorProjectManager.copyContextTargetName",
        "title": "%command.copyContextTargetName.title%",
        "category": "%extension.category%"
      },
      {
        "command": "dagorProjectManager.copyContextTargetFullname",
        "title": "%command.copyContextTargetFullname.title%",
        "category": "%extension.category%"
      },
      {
        "command": "dagorProjectManager.deleteContextProject",
        "title": "%command.deleteContextProject.title%",
        "category": "%extension.category%"
      },
      {
        "command": "dagorProjectManager.deleteContextCommand",
        "title": "%command.deleteContextCommand.title%",
        "category": "%extension.category%"
      },
      {
        "command": "dagorProjectManager.deleteContextScene",
        "title": "%command.deleteContextScene.title%",
        "category": "%extension.category%"
      },
      {
        "command": "dagorProjectManager.folderBuildAll",
        "title": "%command.folderBuildAll.title%"
      },
      {
        "command": "dagorProjectManager.folderOpenDaViewer",
        "title": "%command.folderOpenDaViewer.title%"
      },
      {
        "command": "dagorProjectManager.folderOpenScene",
        "title": "%command.folderOpenScene.title%"
      },
      {
        "command": "dagorProjectManager.folderRunGame",
        "title": "%command.folderRunGame.title%"
      },
      {
        "command": "dagorProjectManager.folderRunCommand",
        "title": "%command.folderRunCommand.title%"
      },
      {
        "command": "dagorProjectManager.folderCreateCommand",
        "title": "%command.folderCreateCommand.title%"
      },
      {
        "command": "dagorProjectManager.folderCreateScene",
        "title": "%command.folderCreateScene.title%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dagorProjectManager",
          "title": "%activitybar.title%",
          "icon": "media/dagor.svg"
        }
      ]
    },
    "views": {
      "dagorProjectManager": [
        {
          "id": "dagorProjectManager.projects",
          "name": "%view.projects.name%",
          "icon": "media/dagor.svg",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "webview/context": [
        {
          "command": "dagorProjectManager.buildAllFromContext",
          "when": "webviewId == 'dagorProjectManager.projects' && webviewSection == 'build'",
          "group": "navigation"
        },
        {
          "command": "dagorProjectManager.buildCodeFromContext",
          "when": "webviewId == 'dagorProjectManager.projects' && webviewSection == 'build'",
          "group": "1_buildComponents@1"
        },
        {
          "command": "dagorProjectManager.buildShadersFromContext",
          "when": "webviewId == 'dagorProjectManager.projects' && webviewSection == 'build'",
          "group": "1_buildComponents@2"
        },
        {
          "command": "dagorProjectManager.buildAssetsFromContext",
          "when": "webviewId == 'dagorProjectManager.projects' && webviewSection == 'build'",
          "group": "1_buildComponents@3"
        },
        {
          "command": "dagorProjectManager.buildVromfsFromContext",
          "when": "webviewId == 'dagorProjectManager.projects' && webviewSection == 'build'",
          "group": "1_buildComponents@4"
        },
        {
          "command": "dagorProjectManager.buildGuiFromContext",
          "when": "webviewId == 'dagorProjectManager.projects' && webviewSection == 'build'",
          "group": "1_buildComponents@5"
        },
        {
          "command": "dagorProjectManager.runSceneInGame",
          "when": "webviewId == 'dagorProjectManager.projects' && webviewSection == 'scene'",
          "group": "navigation@0"
        },
        {
          "command": "dagorProjectManager.folderCreateCommand",
          "when": "webviewId == 'dagorProjectManager.projects' && webviewSection == 'command'",
          "group": "3_command"
        },
        {
          "command": "dagorProjectManager.folderCreateScene",
          "when": "webviewId == 'dagorProjectManager.projects' && webviewSection == 'sceneGroup'",
          "group": "navigation@1"
        },
        {
          "command": "dagorProjectManager.revealContextTarget",
          "when": "webviewId == 'dagorProjectManager.projects' && (webviewSection == 'project' || webviewSection == 'resource' || webviewSection == 'scene' || webviewSection == 'commandItem')",
          "group": "1_reveal@1"
        },
        {
          "command": "dagorProjectManager.revealContextTargetInOS",
          "when": "webviewId == 'dagorProjectManager.projects' && (webviewSection == 'project' || webviewSection == 'resource' || webviewSection == 'scene' || webviewSection == 'commandItem')",
          "group": "1_reveal@2"
        },
        {
          "command": "dagorProjectManager.copyContextTargetName",
          "when": "webviewId == 'dagorProjectManager.projects' && (webviewSection == 'project' || webviewSection == 'resource' || webviewSection == 'scene' || webviewSection == 'commandItem')",
          "group": "9_copy@1"
        },
        {
          "command": "dagorProjectManager.copyContextTargetFullname",
          "when": "webviewId == 'dagorProjectManager.projects' && (webviewSection == 'project' || webviewSection == 'resource' || webviewSection == 'scene' || webviewSection == 'commandItem')",
          "group": "9_copy@2"
        },
        {
          "command": "dagorProjectManager.deleteContextProject",
          "when": "webviewId == 'dagorProjectManager.projects' && webviewSection == 'project'",
          "group": "z_delete"
        },
        {
          "command": "dagorProjectManager.deleteContextCommand",
          "when": "webviewId == 'dagorProjectManager.projects' && webviewSection == 'commandItem'",
          "group": "z_delete"
        },
        {
          "command": "dagorProjectManager.deleteContextScene",
          "when": "webviewId == 'dagorProjectManager.projects' && webviewSection == 'scene'",
          "group": "z_delete"
        }
      ],
      "commandPalette": [
        {
          "command": "dagorProjectManager.buildAllFromContext",
          "when": "false"
        },
        {
          "command": "dagorProjectManager.buildCodeFromContext",
          "when": "false"
        },
        {
          "command": "dagorProjectManager.buildShadersFromContext",
          "when": "false"
        },
        {
          "command": "dagorProjectManager.buildAssetsFromContext",
          "when": "false"
        },
        {
          "command": "dagorProjectManager.buildVromfsFromContext",
          "when": "false"
        },
        {
          "command": "dagorProjectManager.buildGuiFromContext",
          "when": "false"
        },
        {
          "command": "dagorProjectManager.runSceneInGame",
          "when": "false"
        },
        {
          "command": "dagorProjectManager.revealContextTarget",
          "when": "false"
        },
        {
          "command": "dagorProjectManager.revealContextTargetInOS",
          "when": "false"
        },
        {
          "command": "dagorProjectManager.copyContextTargetName",
          "when": "false"
        },
        {
          "command": "dagorProjectManager.copyContextTargetFullname",
          "when": "false"
        },
        {
          "command": "dagorProjectManager.deleteContextProject",
          "when": "false"
        },
        {
          "command": "dagorProjectManager.deleteContextCommand",
          "when": "false"
        },
        {
          "command": "dagorProjectManager.deleteContextScene",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "submenu": "dagorProjectManager.projectFolderContext",
          "when": "resourceScheme == file && explorerResourceIsFolder && resource in dagorProjectManager.projectFolders",
          "group": "navigation"
        },
        {
          "submenu": "dagorProjectManager.blkContext",
          "when": "resourceFilename =~ /\\.blk$/i",
          "group": "navigation"
        }
      ],
      "dagorProjectManager.projectFolderContext": [
        {
          "command": "dagorProjectManager.folderBuildAll",
          "group": "1_dagor"
        },
        {
          "command": "dagorProjectManager.folderOpenDaViewer",
          "group": "2_dagor"
        },
        {
          "command": "dagorProjectManager.folderOpenScene",
          "group": "3_dagor"
        },
        {
          "command": "dagorProjectManager.folderRunGame",
          "group": "4_dagor"
        },
        {
          "command": "dagorProjectManager.folderRunCommand",
          "group": "5_dagor"
        },
        {
          "command": "dagorProjectManager.folderCreateCommand",
          "group": "6_dagor"
        }
      ],
      "dagorProjectManager.blkContext": [
        {
          "command": "dagorProjectManager.openWithDaEditor",
          "when": "resourceFilename =~ /^application\\.blk$/i || resourceFilename =~ /\\.level\\.blk$/i",
          "group": "1_dagor"
        },
        {
          "command": "dagorProjectManager.openWithDaViewer",
          "when": "resourceFilename =~ /^application\\.blk$/i",
          "group": "2_dagor"
        },
        {
          "command": "dagorProjectManager.openWithBlkEditor",
          "when": "resourceFilename =~ /\\.blk$/i",
          "group": "3_dagor"
        }
      ]
    },
    "submenus": [
      {
        "id": "dagorProjectManager.projectFolderContext",
        "label": "%submenu.projectFolderContext.label%"
      },
      {
        "id": "dagorProjectManager.blkContext",
        "label": "%submenu.blkContext.label%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "dagorProjectManager.toolsDirectory": {
          "type": "string",
          "default": "",
          "description": "%configuration.toolsDirectory.description%"
        },
        "dagorProjectManager.daEditorExecutable": {
          "type": "string",
          "default": "daEditor3x-dev.exe",
          "description": "%configuration.daEditorExecutable.description%"
        },
        "dagorProjectManager.daViewerExecutable": {
          "type": "string",
          "default": "assetViewer2-dev.exe",
          "description": "%configuration.daViewerExecutable.description%"
        },
        "dagorProjectManager.blkEditorExecutable": {
          "type": "string",
          "default": "blkEditor-dev.exe",
          "description": "%configuration.blkEditorExecutable.description%"
        },
        "dagorProjectManager.pythonExecutable": {
          "type": "string",
          "default": "python",
          "description": "%configuration.pythonExecutable.description%"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "1.85.0",
    "@vscode/l10n-dev": "^0.0.35",
    "typescript": "^7.0.2"
  }
}
