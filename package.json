{
  "name": "dagor-project-manager",
  "displayName": "Dagor Project Manager",
  "description": "Manage Dagor projects and open Dagor BLK files from VS Code.",
  "license": "MIT",
  "icon": "media/dagor.png",
  "extensionKind": [
    "workspace"
  ],
  "version": "0.1.0",
  "publisher": "project-stalker",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/extension.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "dagorProjectManager.openWithBlkEditor",
        "title": "Open with Dagor blkEditor"
      },
      {
        "command": "dagorProjectManager.openWithDaEditor",
        "title": "Open with Dagor daEditor"
      },
      {
        "command": "dagorProjectManager.openWithDaViewer",
        "title": "Open with Dagor daViewer"
      },
      {
        "command": "dagorProjectManager.openSceneWithDaEditor",
        "title": "Open Scene in daEditor"
      },
      {
        "command": "dagorProjectManager.openProjectWithDaViewer",
        "title": "Open Project in daViewer"
      },
      {
        "command": "dagorProjectManager.buildProject",
        "title": "Build Project Components"
      },
      {
        "command": "dagorProjectManager.generateProject",
        "title": "Generate Project (Not Implemented)"
      },
      {
        "command": "dagorProjectManager.refreshProjects",
        "title": "Refresh Dagor Projects"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dagorProjectManager",
          "title": "Dagor Project Manager",
          "icon": "media/dagor.svg"
        }
      ]
    },
    "views": {
      "dagorProjectManager": [
        {
          "id": "dagorProjectManager.projects",
          "name": "Projects",
          "icon": "media/dagor.svg",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "submenu": "dagorProjectManager.blkContext",
          "when": "resourceFilename =~ /\\.blk$/i",
          "group": "navigation"
        }
      ],
      "dagorProjectManager.blkContext": [
        {
          "command": "dagorProjectManager.openWithDaEditor",
          "when": "resourceFilename =~ /^application\\.blk$/i || resourceFilename =~ /\\.level\\.blk$/i",
          "group": "1_dagor"
        },
        {
          "command": "dagorProjectManager.openWithDaViewer",
          "when": "resourceFilename =~ /^application\\.blk$/i",
          "group": "2_dagor"
        },
        {
          "command": "dagorProjectManager.openWithBlkEditor",
          "when": "resourceFilename =~ /\\.blk$/i",
          "group": "3_dagor"
        }
      ]
    },
    "submenus": [
      {
        "id": "dagorProjectManager.blkContext",
        "label": "Dagor Project Manager"
      }
    ],
    "configuration": {
      "title": "Dagor Project Manager",
      "properties": {
        "dagorProjectManager.toolsDirectory": {
          "type": "string",
          "default": "",
          "description": "Directory containing Dagor CDK executables. Defaults to DAGOR_CDK_DIR or this repository's tools/dagor_cdk folder."
        },
        "dagorProjectManager.daEditorExecutable": {
          "type": "string",
          "default": "daEditor3x-dev.exe",
          "description": "daEditor executable name or absolute path."
        },
        "dagorProjectManager.daViewerExecutable": {
          "type": "string",
          "default": "assetViewer2-dev.exe",
          "description": "daViewer (Asset Viewer) executable name or absolute path."
        },
        "dagorProjectManager.blkEditorExecutable": {
          "type": "string",
          "default": "blkEditor-dev.exe",
          "description": "blkEditor executable name or absolute path."
        },
        "dagorProjectManager.pythonExecutable": {
          "type": "string",
          "default": "python",
          "description": "Python executable used to run the project's build.py script."
        }
      }
    }
  }
}
